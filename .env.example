# Copy to .env (never commit .env) and fill in what you have; everything is optional.

# Google AI Studio key: Gemini voice coach and hosted Gemma debriefs
SURGERY_GEMMA_API_KEY=

# Gemma on Modal (preferred for debriefs): URL from `modal deploy modal_gemma.py`
GEMMA_MODAL_URL=
GEMMA_MODAL_TOKEN=

# Aiven PostgreSQL service URI (attempts, scores, recordings); CA certificate as aiven-ca.pem
AIVEN_DATABASE_URL=

# Aiven Kafka (live telemetry): host:port of the service; ca.pem, service.cert, service.key in kafka/
AIVEN_KAFKA_BOOTSTRAP=
